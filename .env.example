# ===========================================
# DraftURL 환경변수 (.env.example)
# ===========================================
# 이 파일을 복사하여 .env.local 또는 .env로 사용하세요.
# cp .env.example .env.local
#
# 주의: .env, .env.local 파일은 .gitignore에 의해 추적되지 않습니다.

# -------------------------------------------
# 데이터베이스 (PostgreSQL)
# -------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/drafturl
POSTGRES_USER=drafturl
POSTGRES_PASSWORD=drafturl
POSTGRES_DB=drafturl

# -------------------------------------------
# 파일 스토리지 (Cloudflare R2 / S3 호환 / MinIO)
# -------------------------------------------
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY=minioadmin
R2_SECRET_KEY=minioadmin
R2_BUCKET=drafturl-files
R2_REGION=auto

# -------------------------------------------
# JWT 인증
# -------------------------------------------
# 프로덕션에서는 반드시 256비트 이상의 안전한 시크릿으로 변경하세요.
JWT_SECRET=change-me-in-production-must-be-at-least-256-bits
JWT_ACCESS_TOKEN_EXPIRY=3600000
JWT_REFRESH_TOKEN_EXPIRY=604800000

# -------------------------------------------
# OAuth2 (Google)
# -------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -------------------------------------------
# OAuth2 (GitHub)
# -------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -------------------------------------------
# OAuth2 (Naver)
# -------------------------------------------
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# -------------------------------------------
# OAuth2 (Kakao)
# -------------------------------------------
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# -------------------------------------------
# CORS / 프론트엔드 URL
# -------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -------------------------------------------
# OAuth2 Client IDs (프론트엔드용)
# -------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_NAVER_CLIENT_ID=
NEXT_PUBLIC_KAKAO_CLIENT_ID=

# -------------------------------------------
# Sentry (에러 트래킹, 선택사항)
# -------------------------------------------
# DSN이 비어있으면 Sentry가 자동으로 비활성화됩니다.
SENTRY_DSN=

# -------------------------------------------
# Spring 프로파일
# -------------------------------------------
SPRING_PROFILES_ACTIVE=local
